<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install_macos.sh fills in the __PLACEHOLDERS__. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.reel.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REEL__</string>
    <string>tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REEL_CONFIG</key><string>__CONFIG__</string>
    <!-- launchd starts with a bare PATH; ffmpeg lives in Homebrew's bin -->
    <key>PATH</key><string>__BREW__:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <!-- background QoS so overnight transcription doesn't make the Mac sluggish -->
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__LOGS__/tick.out</string>
  <key>StandardErrorPath</key><string>__LOGS__/tick.err</string>
</dict>
</plist>
